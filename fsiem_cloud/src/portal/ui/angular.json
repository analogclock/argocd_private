{
    "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
    "cli": {
        "defaultCollection": "@angular-eslint/schematics",
        "analytics": false
    },
    "version": 1,
    "newProjectRoot": "projects",
    "projects": {
        "fortisiem-portal": {
            "root": "",
            "sourceRoot": "src",
            "projectType": "application",
            "prefix": "zf",
            "schematics": {
                "@schematics/angular:component": {
                    "flat": true,
                    "prefix": "zf",
                    "style": "scss"
                },
                "@schematics/angular:directive": {
                    "prefix": "zf"
                }
            },
            "architect": {
                "build": {
                    "builder": "@angular-devkit/build-angular:browser",
                    "options": {
                        "outputPath": "dist/fortisiem-portal",
                        "index": "src/index.html",
                        "main": "src/main.ts",
                        "tsConfig": "src/tsconfig.app.json",
                        "assets": [
                            "src/assets"
                        ],
                        "styles": [
                            "src/app/styles/styles.scss"
                        ],
                        "stylePreprocessorOptions": {
                          "includePaths": [
                            "src/app/styles"
                          ]
                        },
                        "scripts": [],
                        "aot": true,
                        "polyfills": ["zone.js"],
                        "allowedCommonJsDependencies": [
                          "cerialize",
                          "ip-cidr",
                          "ip-address",
                          "jsbn",
                          "node-forge",
                          "rfdc",
                          "rx",
                          "rx-dom",
                          "sprintf-js"
                        ]
                    },
                    "configurations": {
                        "local": {
                            "outputPath": "dist/fortisiem-portal-local",
                            "fileReplacements": [
                                {
                                    "replace": "src/environments/environment.ts",
                                    "with": "src/environments/environment.local.ts"
                                }
                            ],
                            "outputHashing": "all",
                            "sourceMap": true,
                            "budgets": [
                                {
                                    "type": "anyComponentStyle",
                                    "maximumWarning": "10kb"
                                }
                            ]
                        },
                        "playground": {
                            "outputPath": "dist/fortisiem-portal-playground",
                            "fileReplacements": [
                                {
                                    "replace": "src/environments/environment.ts",
                                    "with": "src/environments/environment.playground.ts"
                                }
                            ],
                            "optimization": true,
                            "outputHashing": "all",
                            "sourceMap": false,
                            "namedChunks": false,
                            "extractLicenses": true,
                            "vendorChunk": false,
                            "buildOptimizer": true,
                            "budgets": [
                                {
                                    "type": "initial",
                                    "maximumWarning": "2mb",
                                    "maximumError": "5mb"
                                },
                                {
                                    "type": "anyComponentStyle",
                                    "maximumWarning": "10kb"
                                }
                            ]
                        },
                        "staging": {
                            "outputPath": "dist/fortisiem-portal-staging",
                            "fileReplacements": [
                                {
                                    "replace": "src/environments/environment.ts",
                                    "with": "src/environments/environment.staging.ts"
                                }
                            ],
                            "optimization": true,
                            "outputHashing": "all",
                            "sourceMap": false,
                            "namedChunks": false,
                            "extractLicenses": true,
                            "vendorChunk": false,
                            "buildOptimizer": true,
                            "budgets": [
                                {
                                    "type": "initial",
                                    "maximumWarning": "2mb",
                                    "maximumError": "5mb"
                                },
                                {
                                    "type": "anyComponentStyle",
                                    "maximumWarning": "10kb"
                                }
                            ]
                        },
                        "prod": {
                            "outputPath": "dist/fortisiem-portal-prod",
                            "fileReplacements": [
                                {
                                    "replace": "src/environments/environment.ts",
                                    "with": "src/environments/environment.prod.ts"
                                }
                            ],
                            "optimization": true,
                            "outputHashing": "all",
                            "sourceMap": false,
                            "namedChunks": false,
                            "extractLicenses": true,
                            "vendorChunk": false,
                            "buildOptimizer": true,
                            "budgets": [
                                {
                                    "type": "initial",
                                    "maximumWarning": "2mb",
                                    "maximumError": "5mb"
                                },
                                {
                                    "type": "anyComponentStyle",
                                    "maximumWarning": "10kb"
                                }
                            ]
                        },
                        "dev": {
                            "outputPath": "dist/fortisiem-portal-dev",
                            "fileReplacements": [
                                {
                                    "replace": "src/environments/environment.ts",
                                    "with": "src/environments/environment.dev.ts"
                                }
                            ],
                            "optimization": true,
                            "outputHashing": "all",
                            "sourceMap": false,
                            "namedChunks": false,
                            "extractLicenses": true,
                            "vendorChunk": false,
                            "buildOptimizer": true,
                            "budgets": [
                                {
                                    "type": "initial",
                                    "maximumWarning": "2mb",
                                    "maximumError": "5mb"
                                },
                                {
                                    "type": "anyComponentStyle",
                                    "maximumWarning": "10kb"
                                }
                            ]
                        }
                    }
                },
                "serve": {
                    "builder": "@angular-devkit/build-angular:dev-server",
                    "options": {
                        "browserTarget": "fortisiem-portal:build"
                    },
                    "configurations": {
                        "prod": {
                            "browserTarget": "fortisiem-portal:build:prod"
                        },
                        "dev": {
                            "browserTarget": "fortisiem-portal:build:dev"
                        },
                        "local": {
                            "browserTarget": "fortisiem-portal:build:local"
                        },
                        "playground": {
                            "browserTarget": "fortisiem-portal:build:playground"
                        }
                    }
                },
                "extract-i18n": {
                    "builder": "@angular-devkit/build-angular:extract-i18n",
                    "options": {
                        "browserTarget": "fortisiem-portal:build"
                    }
                },
                "test": {
                    "builder": "@angular-devkit/build-angular:karma",
                    "options": {
                        "main": "src/test.ts",
                        "tsConfig": "src/tsconfig.spec.json",
                        "karmaConfig": "src/karma.conf.js",
                        "polyfills": ["zone.js", "zone.js/testing"],
                        "codeCoverageExclude": [
                            "src/**/*.mock.ts"
                        ],
                        "styles": [
                            "src/app/styles/styles.scss"
                        ],
                        "scripts": [],
                        "assets": [
                            "src/assets"
                        ]
                    }
                },
                "lint": {
                    "builder": "@angular-eslint/builder:lint",
                    "options": {
                        "lintFilePatterns": [
                            "src/**/*.ts",
                            "src/**/*.html"
                        ]
                    }
                }
            }
        }
    }
}

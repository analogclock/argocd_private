{
  "name": "fortisiem-portal",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "ncu": "ncu",
    "upgrade": "ncu -u",
    "serve": "ng serve --port=4201 --ssl",
    "local": "npm run serve -- --configuration=local",
    "dev": "npm run serve -- --configuration=dev",
    "playground": "npm run serve -- --configuration=playground",
    "staging": "npm run serve -- --configuration=staging",
    "prod": "npm run serve -- --configuration=prod",
    "build": "ng build",
    "test": "ng test --code-coverage",
    "test:all": "npm run test -- --sourceMap=true --watch=false",
    "lint": "eslint -c .eslintrc.js -f codeframe --ext .ts src && echo 'All .ts files passed linting\n' && stylelint --rd 'src/**/*.scss' && echo 'All .scss files passed linting\n'",
    "lint:fix": "eslint -c .eslintrc.js -f codeframe --ext .ts src --fix && echo 'All .ts files passed linting\n' && stylelint --rd 'src/**/*.scss' --fix && echo 'All .scss files passed linting\n'",
    "lint:ts": "eslint -c .eslintrc.js -f codeframe --ext .ts src --fix && echo 'All .ts files passed linting\n'",
    "lint:scss": "stylelint --rd \"src/**/*.scss\" --fix && echo 'All .scss files passed linting\n'",
    "e2e": "ng e2e",
    "check": "ng test --watch=false && npm run lint && ng build --configuration=dev",
    "build:dev": "ng build --configuration=dev",
    "build:playground": "ng build --configuration=playground",
    "build:staging": "ng build --configuration=staging",
    "build:prod": "ng build --configuration=prod"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "~17.3.3",
    "@angular/compiler": "~17.3.3",
    "@angular/core": "~17.3.3",
    "@angular/forms": "~17.3.3",
    "@angular/platform-browser": "~17.3.3",
    "@angular/platform-browser-dynamic": "~17.3.3",
    "@angular/router": "~17.3.3",
    "@swimlane/ngx-charts": "^20.5.0",
    "angular-auth-oidc-client": "^17.0.0",
    "cerialize": "^0.1.18",
    "core-js": "^3.36.1",
    "ip-cidr": "^4.0.0",
    "jwt-decode": "^4.0.0",
    "ngx-cookie": "^6.0.1",
    "node-forge": "^1.3.1",
    "rx-dom": "^7.0.3",
    "rxjs": "~7.8.1",
    "ts-key-enum": "^3.0.12",
    "tslib": "^2.6.2",
    "zone.js": "~0.14.4"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~17.3.3",
    "@angular-eslint/eslint-plugin": "~17.3.0",
    "@angular-devkit/schematics": "~17.3.3",
    "@angular/cli": "~17.3.3",
    "@angular/compiler-cli": "~17.3.3",
    "@angular/language-service": "~17.3.3",
    "@types/node": "^20.12.4",
    "@typescript-eslint/eslint-plugin": "^7.5.0",
    "@typescript-eslint/parser": "^7.5.0",
    "@types/node-forge": "^1.3.11",
    "eslint": "^8.57.0",
    "eslint-formatter-codeframe": "^7.32.1",
    "eslint-plugin-import": "^2.29.1",
    "stylelint": "^16.3.1",
    "stylelint-config-standard": "^36.0.0",
    "stylelint-config-standard-scss": "^13.1.0",
    "stylelint-scss": "^6.2.1",
    "ts-node": "~10.9.2",
    "typescript": "5.4.4"
  },
  "overrides": {
    "debug": "^4.3.4"
  },
  "description": "FortiSiem Cloud web site",
  "main": ".eslintrc.js",
  "author": "Fortinet, FortiSIEM cloud team",
  "license": "UNLICENSED"
}

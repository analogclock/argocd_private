{
  /*
       79 char is lovely for reviews.
       Anything longer than 90 is moved to a new line in gitlab review.
    */
  "editor.rulers": [
    79,
    90
  ],
  "editor.formatOnSave": true,
  "editor.minimap.enabled": false,
  "workbench.colorCustomizations": {
    "editorRuler.foreground": "#ff4081"
  },
  "[terraform]": {
    "editor.defaultFormatter": "hashicorp.terraform"
  },
  "files.insertFinalNewline": true,
  "files.autoSave": "onFocusChange",
  "autoDocstring.docstringFormat": "numpy",
  "flake8.args": [
    "--max-line-length=79"
  ],
  "python.languageServer": "Default",
  "[python]": {
    "editor.defaultFormatter": "ms-python.autopep8",
    "editor.codeActionsOnSave": {
      "source.organizeImports.ruff": "explicit"
    }
  },
  /* Configure Python tests to work with VS Code > Testing tab */
  "python.testing.pytestArgs": [
    ".",
    "--ignore=integration-tests",
    // "--ignore=tests"
  ],
  "python.testing.autoTestDiscoverOnSaveEnabled": true,
  // "python.testing.cwd": "src/python/fsiem_api_client",
  // "python.testing.cwd": "src/python/fsiem_backup",
  // "python.testing.cwd": "src/python/fsiem_daily_job",
  // "python.testing.cwd": "src/python/fsiem_expiry_notification",
  // "python.testing.cwd": "src/python/fsiem_license",
  // "python.testing.cwd": "src/python/fsiem_metrics",
  // "python.testing.cwd": "src/python/fsiem_monitor",
  "python.testing.cwd": "src/python/fsiem_resource_calc",
  // "python.testing.cwd": "src/python/fsiem_scheduled_upgrade",
  // "python.testing.cwd": "src/python/fsiem_setup",
  // "python.testing.cwd": "src/python/fsiem_storage_enforcer",
  // "python.testing.cwd": "src/python/fsiem_terraform_updater",
  // "python.testing.cwd": "src/python/lambda/fsiem_notification_email",
  // "python.testing.cwd": "src/python/lambda/fsiem_ses_reject",
  // "python.testing.cwd": "src/python/lambda/fsiem_ssm_automation",
  // "python.testing.cwd": "src/devops/aws/automated_tools/lambda/remind_stack_deployed",
  "python.testing.unittestEnabled": false,
  "python.testing.pytestEnabled": true,
  "python.analysis.extraPaths": [
    "./src/python/fsiem_api_client"
  ],
}
